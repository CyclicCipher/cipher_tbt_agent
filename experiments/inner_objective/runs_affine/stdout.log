| baseline | 0.184 | 0.000 | 8.00 of 8 |  |
| inner objective | 0.000 | 0.000 | 8.00 of 8 |  |
| baseline + noise | 0.003 | 0.000 | 8.00 of 8 | +0.000 |
| inner objective + noise | 0.000 | 0.000 | 8.00 of 8 | +0.000 |

